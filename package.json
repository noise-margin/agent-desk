{
  "name": "agentdesk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @agentdesk/server dev\" \"pnpm --filter @agentdesk/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "pnpm --filter @agentdesk/server start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@qoder-ai/qoder-agent-sdk",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
